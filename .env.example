# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in. NEVER commit real values.
# Only variables prefixed NEXT_PUBLIC_ are shipped to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Content source ───────────────────────────────────────────────────────────
#   auto   (default) use Sanity when NEXT_PUBLIC_SANITY_PROJECT_ID is set,
#          otherwise fall back to the bundled content_seed.json ("local content")
#   sanity require Sanity; fail loudly if it is not configured (use in production)
#   local  always use content_seed.json (offline demos, CI without a CMS)
CONTENT_SOURCE=auto

# ── Sanity: public identifiers (safe to expose) ──────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# ── Sanity: SECRETS (server only — never prefix with NEXT_PUBLIC_) ───────────
# Viewer-role token (server only). Two jobs:
#   • lets Draft Mode / the Presentation tool read unpublished drafts;
#   • REQUIRED if the dataset is private (published reads then authenticate with it).
# Not needed to render published content from a public dataset.
SANITY_API_READ_TOKEN=
# Editor-role token. Used ONLY by `npm run seed:sanity` on a trusted machine.
# Do NOT add this to your hosting provider's environment.
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity → /api/revalidate webhook (see README).
SANITY_REVALIDATE_SECRET=

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin used for metadata, sitemap and structured data. MUST be set to the
# real https origin in production: while it is the localhost placeholder, robots.txt
# disallows all crawling so a staging deploy cannot be indexed by accident.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Theme (build time) ───────────────────────────────────────────────────────
# plum-luxury (default) | slate-linen. See docs/THEMING.md to add your own.
NEXT_PUBLIC_THEME=plum-luxury

# ── Inquiry form delivery (server only) ──────────────────────────────────────
# Inquiries contain personal data and are deliberately NOT stored in the public
# Sanity dataset. Configure at least one transport or the form will show the
# agent's phone number instead of pretending to deliver.
#   Option A — email through Resend (https://resend.com)
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=
#   Option B — any webhook (Zapier, Make, Slack, your CRM)
INQUIRY_WEBHOOK_URL=
