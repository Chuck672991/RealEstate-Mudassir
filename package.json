{
  "name": "real-estate-mudassir",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test \"scripts/**/*.test.ts\" \"lib/**/*.test.ts\" \"features/**/*.test.ts\" \"components/**/*.test.ts\" \"components/**/*.test.tsx\"",
    "schema:validate": "DO_NOT_TRACK=1 sanity schema validate",
    "typegen": "DO_NOT_TRACK=1 sanity schema extract --path sanity/extract.json --force && DO_NOT_TRACK=1 sanity typegen generate",
    "seed:sanity": "tsx scripts/seed-sanity.ts",
    "seed:sanity:dry": "tsx scripts/seed-sanity.ts --dry-run",
    "assets:manifest": "tsx scripts/build-asset-manifest.ts",
    "assets:check": "tsx scripts/build-asset-manifest.ts --check",
    "images:import": "tsx scripts/import-images.ts",
    "flowers:build": "node scripts/assets/flower-clips.mjs",
    "verify:contrast": "tsx scripts/verify/contrast.ts",
    "verify:interactions": "node scripts/verify/interactions.mjs",
    "verify:a11y": "node scripts/verify/a11y.mjs",
    "verify:seo": "node scripts/verify/seo.mjs",
    "verify:perf": "node scripts/verify/perf.mjs",
    "verify:states": "node scripts/verify/states.mjs",
    "verify:flowers": "node scripts/verify/flowers.mjs",
    "verify:console": "node scripts/verify/console.mjs",
    "screenshots": "node scripts/verify/sections.mjs"
  },
  "dependencies": {
    "@sanity/icons": "^5.2.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.20.0",
    "groq-js": "^2.0.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "next": "16.4.3",
    "next-sanity": "^13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "^6.20.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@next/env": "^16.4.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
